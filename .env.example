# Copy this file to .env.local for local development. Never commit real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
MONGODB_DB_NAME=student360
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-token
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Student 360
APP_BASE_URL=http://127.0.0.1:5173
ACTIVATION_DAILY_LIMIT=100
CRON_SECRET=replace-with-a-long-random-cron-secret
