{
  "crons": [
    { "path": "/api/auth/process-activations", "schedule": "0 4 * * *" },
    { "path": "/api/auth/retry-pending-evaluations", "schedule": "* * * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
